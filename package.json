{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "i18n:check": "node scripts/i18n-check.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "test:isolation": "vitest run tests/isolation.test.ts",
    "test:permissions": "vitest run tests/permissionRegistry.test.ts",
    "test:offline": "vitest run tests/offline-sync.test.ts",
    "verify": "npm run i18n:check && npm run test:permissions && npm run test:isolation && npm run test:offline"
  },
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.22",
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "idb-keyval": "^6.3.0",
    "intl-messageformat": "^12.1.4",
    "next": "16.2.6",
    "next-intl": "^4.14.9",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.8",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
