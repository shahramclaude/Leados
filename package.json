{
  "name": "nextjs-postgresql-template",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "check:routes": "node scripts/check-route-registry.mjs",
    "secret-scan": "node scripts/secret-scan.mjs",
    "audit:verify": "tsx scripts/audit-verify.ts",
    "test": "vitest run",
    "test:security": "vitest run tests/security",
    "verify": "npm run typecheck && npm run lint && npm run check:routes && npm run secret-scan && npm run test && npm audit --omit=dev --audit-level=critical"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "jose": "^6.2.13",
    "next": "^16.4.2",
    "pg": "8.20.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3"
  }
}
