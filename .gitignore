# Dependencies (installed from package-lock.json; never committed)
node_modules/

# Build output and caches
.next/
out/
dist/
build/
coverage/
.tsbuildinfo
tsconfig.tsbuildinfo
*.tsbuildinfo

# Local environment and secrets
.env
.env.*
!.env.example

# Editor / OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Local scratch (scripts keep their real files elsewhere)
*.log
tmp/
.tmp/

# tests/app/server.test.mjs creates a pid-scoped symlink fixture beside the app to
# prove the static server cannot serve a private file through an alias. An
# interrupted run can leave it behind; it is a fixture, never source, and a stray
# copy breaks `eslint .` on a dangling link.
app/server-private-*.js
tmp/server-private-*.json
